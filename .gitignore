:root {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #f3f7ff;
  background: #0f172a;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  --bg-start: #e2d3ff;
  --bg-mid: #dfeafc;
  --bg-end: #f8d9e8;
  --glass-bg: rgba(255, 255, 255, 0.14);
  --glass-border: rgba(255, 255, 255, 0.32);
  --text-primary: #f5f7ff;
  --text-secondary: rgba(242, 245, 255, 0.75);
  --shadow-soft: 0 32px 64px rgba(76, 52, 130, 0.18);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  width: 100%;
}

body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.7), transparent 18%),
    radial-gradient(circle at bottom right, rgba(106, 105, 226, 0.18), transparent 24%),
    linear-gradient(135deg, var(--bg-start) 0%, var(--bg-mid) 45%, var(--bg-end) 100%);
  overflow: hidden;
}

button {
  font: inherit;
}

.app-shell {
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.screen {
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  position: relative;
}

.fade-in {
  animation: fadeSlideUp 0.7s ease both;
}

@keyframes fadeSlideUp {
  0% {
    opacity: 0;
    transform: translateY(18px) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes softRise {
  0% {
    opacity: 0;
    transform: translateY(18px) scale(0.97);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.glass-card,
.topic-card,
.home-card,
.bottom-nav,
.mobile-frame {
  background: var(--glass-bg);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-soft);
}

.intro-screen {
  background: linear-gradient(160deg, rgba(136, 84, 223, 0.22) 0%, rgba(125, 211, 252, 0.18) 45%, rgba(255, 255, 255, 0.18) 100%);
}

.brand-lockup {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18px;
  animation: logoFloat 1.3s ease both;
}

@keyframes logoFloat {
  0% {
    opacity: 0;
    transform: scale(0.8) translateY(20px);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.brand-mark {
  width: 66px;
  height: 66px;
  border-radius: 22px;
  display: grid;
  place-items: center;
  font-size: 2rem;
  font-weight: 700;
  background: linear-gradient(135deg, rgba(255,255,255,0.65), rgba(152, 162, 255, 0.35));
  border: 1px solid rgba(255, 255, 255, 0.42);
  box-shadow: 0 18px 40px rgba(97, 88, 170, 0.2);
  color: #fff;
}

.brand-copy {
  text-align: center;
  color: rgba(255, 255, 255, 0.95);
}

.brand-copy h1 {
  margin: 0;
  font-size: clamp(2.3rem, 8vw, 4rem);
  line-height: 1;
  letter-spacing: -0.06em;
  font-weight: 700;
}

.brand-copy p {
  margin: 12px 0 0;
  font-size: 0.95rem;
  letter-spacing: 0.06em;
  color: rgba(255, 255, 255, 0.82);
  text-transform: none;
}

.info-card,
.welcome-final {
  width: min(100%, 380px);
  border-radius: 30px;
  padding: 26px 22px 22px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
}

.mini-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 10px 6px 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: rgba(255,255,255,0.9);
  font-size: 0.8rem;
  letter-spacing: 0.03em;
}

.mini-icon {
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border-radius: 8px;
  background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(176, 188, 255, 0.4));
  color: #6a5bd8;
  font-weight: 700;
}

.info-card h2,
.welcome-final h2 {
  margin: 0;
  font-size: clamp(2rem, 7vw, 2.7rem);
  line-height: 1.1;
  letter-spacing: -0.05em;
  color: #fefeff;
}

.info-card p {
  margin: 0;
  font-size: 1rem;
  color: var(--text-secondary);
}

.primary-btn {
  width: 100%;
  border: 0;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(255,255,255,0.35), rgba(165,181,255,0.25));
  color: #fff;
  padding: 16px 18px;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  border: 1px solid rgba(255,255,255,0.38);
  box-shadow: 0 18px 30px rgba(82, 79, 150, 0.18);
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
}

.primary-btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.03);
}

.primary-btn:active {
  transform: scale(0.98);
}

.explore-panel {
  width: min(100%, 430px);
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.section-heading {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  color: rgba(255,255,255,0.9);
}

.eyebrow {
  margin: 0;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.7;
}

.section-heading h3 {
  margin: 0;
  font-size: 2rem;
  letter-spacing: -0.05em;
}

.topic-list {
  display: grid;
  gap: 12px;
  animation: softRise 0.7s ease both;
}

.topic-card {
  width: 100%;
  padding: 16px 16px 18px;
  border-radius: 22px;
  color: rgba(255,255,255,0.9);
  animation: softRise 0.8s ease both;
}

.topic-card:nth-child(2) {
  animation-delay: 0.08s;
}

.topic-card:nth-child(3) {
  animation-delay: 0.16s;
}

.topic-card.blue {
  background: linear-gradient(135deg, rgba(120, 171, 255, 0.2), rgba(255,255,255,0.08));
}

.topic-card.purple {
  background: linear-gradient(135deg, rgba(162, 120, 255, 0.2), rgba(255,255,255,0.08));
}

.topic-card.teal {
  background: linear-gradient(135deg, rgba(104, 208, 185, 0.2), rgba(255,255,255,0.08));
}

.topic-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px;
  border-radius: 10px;
  margin-bottom: 12px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  font-size: 0.8rem;
  letter-spacing: 0.04em;
}

.topic-card h4 {
  margin: 0 0 8px;
  font-size: 1.3rem;
  letter-spacing: -0.04em;
}

.topic-card p {
  margin: 0;
  color: rgba(255,255,255,0.72);
  font-size: 0.95rem;
}

.small-brand {
  gap: 0;
}

.welcome-final {
  text-align: center;
  align-items: center;
}

.home-screen {
  padding-top: 18px;
  padding-bottom: 18px;
}

.mobile-frame {
  width: min(100%, 430px);
  min-height: 780px;
  border-radius: 36px;
  padding: 18px 18px 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: rgba(255,255,255,0.1);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 4px 10px;
}

.brand-inline {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: rgba(255,255,255,0.96);
  font-size: 1.1rem;
  font-weight: 600;
}

.brand-mark.small {
  width: 30px;
  height: 30px;
  min-width: 30px;
  border-radius: 10px;
  font-size: 1rem;
}

.home-main {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 4px 4px 0;
}

.greeting {
  margin: 0;
  font-size: clamp(1.4rem, 5vw, 2rem);
  line-height: 1.2;
  letter-spacing: -0.05em;
  color: rgba(255,255,255,0.96);
}

.home-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.home-card {
  min-height: 118px;
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  color: rgba(255,255,255,0.92);
  font-size: 1.1rem;
  letter-spacing: -0.04em;
  background: rgba(255,255,255,0.08);
  animation: softRise 0.7s ease both;
}

.card-1 { background: linear-gradient(135deg, rgba(142,166,255,0.26), rgba(255,255,255,0.08)); }
.card-2 { background: linear-gradient(135deg, rgba(181,134,255,0.26), rgba(255,255,255,0.08)); }
.card-3 { background: linear-gradient(135deg, rgba(104,208,185,0.26), rgba(255,255,255,0.08)); }
.card-4 { background: linear-gradient(135deg, rgba(250,181,202,0.22), rgba(255,255,255,0.08)); }

.bottom-nav {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  border-radius: 18px;
  padding: 10px 8px;
  margin-top: 10px;
}

.nav-item {
  appearance: none;
  border: 0;
  background: transparent;
  color: rgba(255,255,255,0.7);
  border-radius: 12px;
  padding: 12px 8px 8px;
  font-size: 0.8rem;
  font-weight: 500;
  transition: background 0.2s ease, transform 0.2s ease;
}

.nav-item.active {
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,1);
}

.nav-item:active {
  transform: scale(0.97);
}

@media (min-width: 640px) {
  .screen {
    padding: 30px;
  }

  .mobile-frame {
    min-height: 720px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
